option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    # Set these via the EB console or eb setenv — do NOT commit secrets here:
    # SESSION_SECRET: <generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
    # When using an EB-attached RDS instance, these are set automatically:
    #   RDS_HOSTNAME, RDS_PORT, RDS_DB_NAME, RDS_USERNAME, RDS_PASSWORD
    # Alternatively, set your own DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD
  # For Node.js platform on Amazon Linux 2023:
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  # Legacy platform support (Amazon Linux 1/2):
  aws:elasticbeanstalk:container:nodejs:
    ProxyServer: nginx
